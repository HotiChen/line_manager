{
  "name": "pinti-line",
  "compatibility_date": "2025-04-13",
  "main": "worker_src/index.js",
  "kv_namespaces": [
    {
      "id": "7cbba24c35ad464d875ef1fc5107604e",
      "binding": "KV_LINE_STORAGE"
    }
  ],
  // 掛在 imhoti.tw 的 /lm 底下。imhoti.tw 的根是 WordPress，route 只接這一條
  // 路徑，其餘流量照原樣走回源站。
  //
  // `/lm*`（不是 `/lm/*`）是刻意的：要讓沒有尾斜線的 `/lm` 也進到這個 worker，
  // 它才能 301 到 `/lm/`。前端的資源參照全部是相對路徑，少了那個尾斜線
  // `css/a.css` 會解析到 `imhoti.tw/css/a.css`，也就是 WordPress 的地盤。
  "routes": [
    {
      "pattern": "imhoti.tw/lm*",
      "zone_name": "imhoti.tw"
    }
  ],
  "vars": {
    // 這個 worker 掛在哪個子路徑底下（見 lib/mount.js）。
    // 必須與上面 routes 的前綴一致 —— 不一致的話每個請求都會 404，而且
    // 沒有任何程式碼會報錯。tests/unit/test_wrangler_config.mjs 會比對。
    //
    // 注意：MOUNT_PATH 是對所有 host 生效的，所以 workers.dev 的網址也變成
    // pinti-line.hotichen.workers.dev/lm/… —— 根路徑不再回應。
    "MOUNT_PATH": "/lm",
    "LIFF_ID": "1653928585-8Kkz0jnz",
    // Channel ID 就是 LIFF_ID 的前半段，前端 env/config.js 也會送到瀏覽器，
    // 本身不是機密；放在 vars 讓 authenticate() 能比對 token 的 client_id。
    "LIFF_CHANNEL_ID": "1653928585",
    "AUTH_MODE": "liff"
  },
  // 以下 secrets 需透過 `wrangler secret put` 設定，不要寫在這裡：
  // - MIGRATION_SECRET: migration API 的驗證金鑰
  "env": {
    "dev": {
      "name": "pinti-line-dev",
      "kv_namespaces": [
        {
          // dev 專用 namespace（title: pinti-line-dev-dev-KV_LINE_STORAGE）。
          // 先前 dev 與 prod 都指向 7cbba24c…，而 dev 的 AUTH_MODE 是 legacy
          // （接受自報的 X-User-Id 當身分），等於本機跑 wrangler dev --env dev
          // 就能用任意身分讀寫正式環境的 924 筆資料。tests/unit/test_wrangler_config.mjs
          // 會擋住再次指回去。
          "id": "134f95b543c4447e872a782be652b13c",
          "preview_id": "134f95b543c4447e872a782be652b13c",
          "binding": "KV_LINE_STORAGE"
        }
      ],
      "vars": {
        "LIFF_ID": "1653928585-8Kkz0jnz",
        "LIFF_CHANNEL_ID": "1653928585",
        "BASE_URL": "http://127.0.0.1:5500"
        // AUTH_MODE 刻意不設 —— 缺值時 middleware/auth.js 視同 "liff"（fail-closed）。
        //
        // 這裡原本是 "legacy"，而 legacy 接受自報的 X-User-Id 當身分。vars 是
        // **部署**出去的值，所以那等於讓線上的 dev worker 對任何知道某個
        // owner userId 的人全開。2026-11-11 量到的就是這個：無身分 401、
        // 隨手編一個 X-User-Id 回 200。
        //
        // 本機要用 legacy 請寫進 .dev.vars（已被 .gitignore 擋住）：
        //     AUTH_MODE=legacy
        // 那個檔案只餵 `wrangler dev`，不會被部署。
        // tests/unit/test_wrangler_config.mjs 會擋住再寫回來。
      }
      // Queue configuration (需付費方案)
      // "queues": {
      //   "producers": [...],
      //   "consumers": [...]
      // }
    }
  },
  "site": {
    "bucket": "./",
    "include": [
      "css/**/*",
      "js/**/*",
      "pages/**/*",
      "index.html",
      "helper/**/*",
      "env/**/*"
    ],
    "exclude": [
      "node_modules",
      "worker_src",
      "wrangler.jsonc",
      "package.json",
      "package-lock.json",
      ".*"
    ]
  }
}