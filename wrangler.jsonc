{
  "name": "pinti-line",
  "compatibility_date": "2025-04-13",
  "main": "worker_src/index.js",
  "kv_namespaces": [
    {
      "id": "7cbba24c35ad464d875ef1fc5107604e",
      "binding": "KV_LINE_STORAGE"
    }
  ],
  "vars": {
    "LIFF_ID": "1653928585-8Kkz0jnz",
    // Channel ID 就是 LIFF_ID 的前半段，前端 env/config.js 也會送到瀏覽器，
    // 本身不是機密；放在 vars 讓 authenticate() 能比對 token 的 client_id。
    "LIFF_CHANNEL_ID": "1653928585",
    "AUTH_MODE": "liff"
  },
  // 以下 secrets 需透過 `wrangler secret put` 設定，不要寫在這裡：
  // - MIGRATION_SECRET: migration API 的驗證金鑰
  "env": {
    "dev": {
      "name": "pinti-line-dev",
      "kv_namespaces": [
        {
          "id": "7cbba24c35ad464d875ef1fc5107604e",
          "preview_id": "7cbba24c35ad464d875ef1fc5107604e",
          "binding": "KV_LINE_STORAGE"
        }
      ],
      "vars": {
        "LIFF_ID": "1653928585-8Kkz0jnz",
        "LIFF_CHANNEL_ID": "1653928585",
        "BASE_URL": "http://127.0.0.1:5500",
        "AUTH_MODE": "legacy"
      }
      // Queue configuration (需付費方案)
      // "queues": {
      //   "producers": [...],
      //   "consumers": [...]
      // }
    }
  },
  "site": {
    "bucket": "./",
    "include": [
      "css/**/*",
      "js/**/*",
      "pages/**/*",
      "index.html",
      "helper/**/*",
      "env/**/*"
    ],
    "exclude": [
      "node_modules",
      "worker_src",
      "wrangler.jsonc",
      "package.json",
      "package-lock.json",
      ".*"
    ]
  }
}