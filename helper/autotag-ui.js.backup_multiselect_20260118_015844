/**
 * Auto Tag UI Helper
 * 
 * Provides shared UI components and utilities for auto-tag functionality
 * across Rich Menu, Imagemap, and Flex Message editors.
 */

/**
 * Creates auto-tag input fields HTML
 * @param {string} idPrefix - Prefix for input IDs (e.g., 'richmenu', 'imagemap', 'flex')
 * @param {boolean} compact - Use compact layout (default: false)
 * @returns {string} HTML string
 */
export function createAutoTagFields(idPrefix, compact = false) {
    if (compact) {
        return `
      <div class="mb-3 border-top pt-3">
        <label class="form-label">
          <i class="bi bi-tags text-info"></i> 
          <strong>自動標籤設定</strong>
          <small class="text-muted">(點擊後自動貼標籤)</small>
        </label>
        <div class="row g-2">
          <div class="col-6">
            <label class="small text-muted mb-1">觸發後添加標籤</label>
            <input type="text" 
                   class="form-control form-control-sm" 
                   id="${idPrefix}-auto-tags-add" 
                   placeholder="VIP, 潛在客戶">
          </div>
          <div class="col-6">
            <label class="small text-muted mb-1">觸發後移除標籤</label>
            <input type="text" 
                   class="form-control form-control-sm" 
                   id="${idPrefix}-auto-tags-remove" 
                   placeholder="新手">
          </div>
        </div>
        <div class="form-text mt-1">
          <i class="bi bi-info-circle"></i> 當使用者點擊此按鈕時，會自動更新其標籤。若有多個請用逗號分隔。
        </div>
      </div>
    `;
    } else {
        return `
      <div class="mb-3">
        <label class="form-label">
          <strong>🏷️ 自動標籤設定</strong>
          <small class="text-muted">(點擊後自動貼標籤)</small>
        </label>
        
        <div class="input-group mb-2">
          <span class="input-group-text">➕ 添加</span>
          <input type="text" 
                 id="${idPrefix}-auto-tags-add" 
                 class="form-control"
                 placeholder="添加標籤 (逗號分隔，例如：vip, premium)">
        </div>
        
        <div class="input-group">
          <span class="input-group-text">➖ 移除</span>
          <input type="text" 
                 id="${idPrefix}-auto-tags-remove" 
                 class="form-control"
                 placeholder="移除標籤 (逗號分隔，例如：newbie, trial)">
        </div>
        
        <small class="text-muted">
          <i class="bi bi-info-circle"></i> 
          當使用者點擊此按鈕時，系統會自動為其添加或移除標籤，便於後續分眾管理。
        </small>
      </div>
    `;
    }
}

/**
 * Gets auto-tag data from input fields
 * @param {string} idPrefix - Prefix for input IDs
 * @returns {Object} { add: [], remove: [] }
 */
export function getAutoTagsFromInputs(idPrefix) {
    const addInput = document.getElementById(`${idPrefix}-auto-tags-add`);
    const removeInput = document.getElementById(`${idPrefix}-auto-tags-remove`);

    const addValue = addInput ? addInput.value : '';
    const removeValue = removeInput ? removeInput.value : '';

    const add = cleanTagArray(addValue);
    const remove = cleanTagArray(removeValue);

    return { add, remove };
}

/**
 * Sets auto-tag values to input fields
 * @param {string} idPrefix - Prefix for input IDs
 * @param {Object} autoTags - { add: [], remove: [] }
 */
export function setAutoTagsToInputs(idPrefix, autoTags) {
    const addInput = document.getElementById(`${idPrefix}-auto-tags-add`);
    const removeInput = document.getElementById(`${idPrefix}-auto-tags-remove`);

    if (addInput) {
        addInput.value = (autoTags?.add || []).join(', ');
    }

    if (removeInput) {
        removeInput.value = (autoTags?.remove || []).join(', ');
    }
}

/**
 * Cleans and validates tag array from comma-separated string
 * @param {string} input - Comma-separated tags
 * @returns {Array} Clean array of tags
 */
function cleanTagArray(input) {
    if (!input || typeof input !== 'string') return [];

    return input
        .split(',')
        .map(tag => tag.trim())
        .filter(tag => tag.length > 0)
        .filter((tag, index, arr) => arr.indexOf(tag) === index); // Remove duplicates
}

/**
 * Creates auto-tag object for storage
 * @param {Array} add - Tags to add
 * @param {Array} remove - Tags to remove
 * @returns {Object|undefined} Auto-tag object or undefined if empty
 */
export function createAutoTagObject(add, remove) {
    const cleanAdd = Array.isArray(add) ? add.filter(t => t) : [];
    const cleanRemove = Array.isArray(remove) ? remove.filter(t => t) : [];

    if (cleanAdd.length === 0 && cleanRemove.length === 0) {
        return undefined;
    }

    return {
        add: cleanAdd,
        remove: cleanRemove
    };
}

/**
 * Displays auto-tags as pills/badges
 * @param {Object} autoTags - { add: [], remove: [] }
 * @returns {string} HTML string with badges
 */
export function renderAutoTagsDisplay(autoTags) {
    if (!autoTags || (!autoTags.add?.length && !autoTags.remove?.length)) {
        return '<span class="text-muted">無自動標籤</span>';
    }

    let html = '';

    if (autoTags.add && autoTags.add.length > 0) {
        html += autoTags.add.map(tag =>
            `<span class="badge bg-success me-1"><i class="bi bi-plus-circle"></i> ${tag}</span>`
        ).join('');
    }

    if (autoTags.remove && autoTags.remove.length > 0) {
        html += autoTags.remove.map(tag =>
            `<span class="badge bg-danger me-1"><i class="bi bi-dash-circle"></i> ${tag}</span>`
        ).join('');
    }

    return html;
}

/**
 * Validates auto-tag configuration
 * @param {Object} autoTags - { add: [], remove: [] }
 * @returns {Object} { valid: boolean, errors: [] }
 */
export function validateAutoTags(autoTags) {
    const errors = [];

    if (!autoTags) {
        return { valid: true, errors: [] };
    }

    // Check for conflicting tags (same tag in both add and remove)
    if (autoTags.add && autoTags.remove) {
        const conflicts = autoTags.add.filter(tag => autoTags.remove.includes(tag));
        if (conflicts.length > 0) {
            errors.push(`標籤衝突：${conflicts.join(', ')} 同時出現在添加和移除列表中`);
        }
    }

    // Check for invalid characters
    const invalidChars = /[<>\"\']/;
    const allTags = [...(autoTags.add || []), ...(autoTags.remove || [])];
    const invalidTags = allTags.filter(tag => invalidChars.test(tag));
    if (invalidTags.length > 0) {
        errors.push(`標籤包含無效字元：${invalidTags.join(', ')}`);
    }

    return {
        valid: errors.length === 0,
        errors
    };
}

/**
 * Merges auto-tags into postback data
 * @param {string} originalData - Original postback data
 * @param {Object} autoTags - { add: [], remove: [] }
 * @returns {string} JSON string with merged data
 */
export function mergeAutoTagsToPostbackData(originalData, autoTags) {
    if (!autoTags || (!autoTags.add?.length && !autoTags.remove?.length)) {
        return originalData;
    }

    let dataObject;

    // Try to parse original data as JSON
    try {
        dataObject = JSON.parse(originalData);
    } catch {
        // If not JSON, create a wrapper object
        dataObject = { data: originalData };
    }

    // Add auto-tags to the object
    dataObject.autoTags = autoTags;

    return JSON.stringify(dataObject);
}

/**
 * Extracts auto-tags from postback data
 * @param {string} postbackData - Postback data string
 * @returns {Object|null} Auto-tags object or null
 */
export function extractAutoTagsFromPostbackData(postbackData) {
    if (!postbackData) return null;

    try {
        const dataObject = JSON.parse(postbackData);
        return dataObject.autoTags || null;
    } catch {
        return null;
    }
}
