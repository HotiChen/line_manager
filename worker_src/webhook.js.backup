/**
 * 記錄互動歷史
 */
async function recordInteraction(env, ownerId, memberId, interaction) {
    const key = `member_interaction_${ownerId}_${memberId}`;
    const data = JSON.parse(await env.KV_LINE_STORAGE.get(key) || '{"interactions": [], "summary": {}}');

    data.interactions.push(interaction);

    // 只保留最近 100 筆
    if (data.interactions.length > 100) {
        data.interactions = data.interactions.slice(-100);
    }

    // 更新摘要
    const now = new Date();
    const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    const monthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

    data.summary = {
        total: data.interactions.length,
        thisWeek: data.interactions.filter(i => new Date(i.timestamp) > weekAgo).length,
        thisMonth: data.interactions.filter(i => new Date(i.timestamp) > monthAgo).length,
        lastInteraction: interaction.timestamp
    };

    await env.KV_LINE_STORAGE.put(key, JSON.stringify(data));
}

