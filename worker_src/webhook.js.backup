/**
 * LINE Webhook Handler
 * 處理 Follow, Message, Unfollow 等事件
 * 自動收集 Member 資料
 */

import { jsonResponse } from "../lib/utils.js";
import { addTagsToEntity } from "../lib/tag_system.js";
import { incrementMessageCount } from "../lib/message_stats.js";

/**
 * 主要 Webhook 入口
 */
export async function handleWebhook(request, env) {
    try {
        const body = await request.json();
        const events = body.events || [];

        for (const event of events) {
            await processEvent(event, env);
        }

        return new Response("OK", { status: 200 });
    } catch (error) {
        console.error("❌ [Webhook] 處理失敗:", error);
        return new Response("Error", { status: 500 });
    }
}

/**
 * 處理單一事件
 */
async function processEvent(event, env) {
    const { type, source, message, timestamp } = event;
    const memberId = source?.userId;

    if (!memberId) {
        console.log("⚠️ [Webhook] 無 userId，跳過");
        return;
    }

    // 取得 bot destination 來判斷 ownerId
    const destination = event.destination;
    const ownerId = await getOwnerIdByDestination(env, destination);

    if (!ownerId) {
        console.warn("⚠️ [Webhook] 找不到對應的 ownerId for destination:", destination);
        return;
    }

    console.log(`📡 [Webhook] ${type} event from ${memberId}`);

    switch (type) {
        case 'follow':
            await handleFollow(env, ownerId, memberId, timestamp);
            break;
        case 'message':
            await handleMessage(env, ownerId, memberId, message, timestamp);
            break;
        case 'unfollow':
            await handleUnfollow(env, ownerId, memberId, timestamp);
            break;
        case 'postback':
            await handlePostback(env, ownerId, memberId, timestamp, event);
            break;
    }
}

/**
 * 處理 Follow 事件 - 建立新 Member 或重新啟用
 */
async function handleFollow(env, ownerId, memberId, timestamp) {
    const profileKey = `member_profile_${ownerId}_${memberId}`;
    const token = await getAccessToken(env, ownerId);

    if (!token) {
        console.error("❌ [Follow] 無法取得 Access Token");
        return;
    }

    // 檢查是否已存在（回歸會員）
    const existing = await env.KV_LINE_STORAGE.get(profileKey);

    if (existing) {
        // 回歸會員：重新啟用並發送歡迎回來訊息
        const profile = JSON.parse(existing);
        const wasInactive = profile.status === 'inactive';

        profile.status = 'active';
        profile.lastInteraction = new Date(timestamp).toISOString();
        profile.totalInteractions = (profile.totalInteractions || 0) + 1;

        await env.KV_LINE_STORAGE.put(profileKey, JSON.stringify(profile));

        // 記錄互動
        await recordInteraction(env, ownerId, memberId, {
            timestamp: new Date(timestamp).toISOString(),
            type: 'follow',
            content: wasInactive ? '重新加入好友' : '已存在會員'
        });

        console.log(`✅ [Follow] 重新啟用會員: ${memberId} (${profile.lineName})`);

        // 檢查是否已完成會員資料
        const hasCompletedProfile = profile.name && profile.email;

        // 發送歡迎回來訊息
        await sendWelcomeBackMessage(env, memberId, token, hasCompletedProfile);
        return;
    }

    // 新會員：從 LINE API 取得 Profile
    let lineProfile = {};
    try {
        const response = await fetch(`https://api.line.me/v2/bot/profile/${memberId}`, {
            headers: { Authorization: `Bearer ${token}` }
        });

        if (response.ok) {
            lineProfile = await response.json();
        } else {
            console.warn("⚠️ [Follow] 無法取得 LINE Profile:", await response.text());
        }
    } catch (error) {
        console.error("❌ [Follow] LINE API 錯誤:", error);
    }

    // 建立新 Member Profile（標準版）
    const profile = {
        memberId,
        status: 'active',
        source: 'webhook',
        name: '',  // 待手動填寫或 LIFF 補充
        lineName: lineProfile.displayName || '',
        pictureUrl: lineProfile.pictureUrl || '',
        email: '',
        phone: '',
        gender: '',
        birthday: '',
        joinedAt: new Date(timestamp).toISOString(),
        lastInteraction: new Date(timestamp).toISOString(),
        totalInteractions: 1,
        tags: [],
        note: '',
        temperature: 'warm',
        temperatureScore: 50
    };

    await env.KV_LINE_STORAGE.put(profileKey, JSON.stringify(profile));
    console.log(`✅ [Follow] 新增會員: ${memberId} (${lineProfile.displayName})`);

    // 加入 Member 列表
    const listKey = `member_list_${ownerId}`;
    const list = JSON.parse(await env.KV_LINE_STORAGE.get(listKey) || "[]");
    if (!list.includes(memberId)) {
        list.push(memberId);
        await env.KV_LINE_STORAGE.put(listKey, JSON.stringify(list));
    }

    // 初始化互動記錄
    await recordInteraction(env, ownerId, memberId, {
        timestamp: new Date(timestamp).toISOString(),
        type: 'follow',
        content: '加入好友'
    });

    // 發送新會員歡迎訊息（含會員註冊選項）
    await sendWelcomeMessage(env, ownerId, memberId, token);
}

/**
 * 處理 Message 事件 - 更新互動記錄
 */
async function handleMessage(env, ownerId, memberId, message, timestamp) {
    // 記錄互動
    await recordInteraction(env, ownerId, memberId, {
        timestamp: new Date(timestamp).toISOString(),
        type: 'message',
        content: message?.text || message?.type || 'message'
    });

    // 更新 Profile
    const profileKey = `member_profile_${ownerId}_${memberId}`;
    const profile = JSON.parse(await env.KV_LINE_STORAGE.get(profileKey) || "{}");

    if (profile.memberId) {
        profile.lastInteraction = new Date(timestamp).toISOString();
        profile.totalInteractions = (profile.totalInteractions || 0) + 1;
        await env.KV_LINE_STORAGE.put(profileKey, JSON.stringify(profile));
    }

    console.log(`📝 [Message] 記錄互動: ${memberId}`);
}

/**
 * 處理 Unfollow 事件
 */
async function handleUnfollow(env, ownerId, memberId, timestamp) {
    const profileKey = `member_profile_${ownerId}_${memberId}`;
    const profile = JSON.parse(await env.KV_LINE_STORAGE.get(profileKey) || "{}");

    if (profile.memberId) {
        profile.status = 'inactive';
        profile.lastInteraction = new Date(timestamp).toISOString();
        await env.KV_LINE_STORAGE.put(profileKey, JSON.stringify(profile));
    }

    await recordInteraction(env, ownerId, memberId, {
        timestamp: new Date(timestamp).toISOString(),
        type: 'unfollow',
        content: '取消好友'
    });

    console.log(`👋 [Unfollow] 會員離開: ${memberId}`);
}

/**
 * 處理 Postback 事件
 */
async function handlePostback(env, ownerId, memberId, timestamp, event) {
    const postbackData = event?.postback?.data || '';

    // 解析 postback data
    const params = new URLSearchParams(postbackData);
    const action = params.get('action');

    console.log(`📬 [Postback] action: ${action}, memberId: ${memberId}`);

    // 記錄互動
    await recordInteraction(env, ownerId, memberId, {
        timestamp: new Date(timestamp).toISOString(),
        type: 'postback',
        content: `${action || 'button_click'}`
    });

    // 更新最後互動時間
    const profileKey = `member_profile_${ownerId}_${memberId}`;
    const profile = JSON.parse(await env.KV_LINE_STORAGE.get(profileKey) || "{}");

    if (profile.memberId) {
        profile.lastInteraction = new Date(timestamp).toISOString();
        profile.totalInteractions = (profile.totalInteractions || 0) + 1;
        await env.KV_LINE_STORAGE.put(profileKey, JSON.stringify(profile));
    }

    // 根據 action 處理不同的回應
    const token = await getAccessToken(env, ownerId);

    if (action === 'register_member') {
        // 用戶選擇填寫會員資料
        await sendMemberRegistrationLink(env, ownerId, memberId, token);
    } else if (action === 'skip_registration') {
        // 用戶選擇稍後再說
        await sendSkipMessage(env, memberId, token);
    }
}

