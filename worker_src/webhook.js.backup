/**
 * 輔助函數：根據 destination 取得 ownerId
 */
async function getOwnerIdByDestination(env, destination) {
    // 方法 1：從 destination mapping 取得
    const ownerId = await env.KV_LINE_STORAGE.get(`destination_user_${destination}`);
    if (ownerId) return ownerId;

    // 方法 2：遍歷所有 access_tokens 找到匹配的（備用）
    // 這需要事先建立 destination ↔ userId 的映射

    return null;
}

/**
 * 輔助函數：取得 Access Token
 */
async function getAccessToken(env, ownerId) {
    try {
        const currentProject = await env.KV_LINE_STORAGE.get(`current_token_${ownerId}`);
        const accessTokens = JSON.parse(await env.KV_LINE_STORAGE.get(`access_tokens_${ownerId}`) || "{}");

        if (currentProject && accessTokens[currentProject]) {
            return accessTokens[currentProject].token;
        }

        // 如果沒有 current_token，取第一個
        const firstProject = Object.keys(accessTokens)[0];
        if (firstProject) {
            return accessTokens[firstProject].token;
        }

        return null;
    } catch (error) {
        console.error("❌ [Token] 取得失敗:", error);
        return null;
    }
}
