            const matchedKeyword = await this.matchKeyword(text);

            if (matchedKeyword && node.type === NodeTypes.MESSAGE_TEXT) {
                // 匹配到 keyword，轉換為 Keyword 節點
                console.log(`[updateNodeText] 文字 "${text}" 匹配到關鍵字，轉換為 Keyword 節點`);

                // 修改節點類型和資料
                node.type = NodeTypes.KEYWORD;
                node.data.keyword = matchedKeyword.keyword;
                node.data.matchType = matchedKeyword.matchType || 'exact';
                node.data.label = `🔑 ${matchedKeyword.keyword}`;
                delete node.data.text; // 移除 text 欄位

                // 重新渲染節點
                const nodeElement = document.getElementById(nodeId);
                if (nodeElement) {
                    nodeElement.remove();
                    this.renderNode(node);
                }

                // 顯示通知
                toast.info(`✨ 自動轉換為關鍵字節點: ${matchedKeyword.keyword}`);

                // 重新顯示屬性面板（現在是 keyword 節點）
                this.showNodeProperties(nodeId);
            } else {
                // 沒有匹配或不是 text 節點，正常更新文字
                node.data.text = text;

                // 更新節點的視覺顯示
                const nodeElement = document.getElementById(nodeId);
                if (nodeElement) {
                    const previewElement = nodeElement.querySelector('.node-preview');
                    if (previewElement) {
                        const preview = text.length > 30 ? text.substring(0, 30) + '...' : text;
                        previewElement.textContent = preview || '(空白訊息)';
                    }
                }
            }

            this.saveToLocalStorage();
        }
    }

