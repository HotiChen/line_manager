    /**
     * 縮放畫布
     */
    zoomCanvas(delta) {
        const oldZoom = this.canvasZoom;
        this.canvasZoom = Math.max(0.25, Math.min(3.0, this.canvasZoom + delta));

        if (oldZoom === this.canvasZoom) {
            if (this.canvasZoom >= 3.0) {
                toast.info('已達最大縮放 (300%)');
            } else {
                toast.info('已達最小縮放 (25%)');
            }
            return;
        }

        // 應用縮放
        this.applyCanvasZoom();

        const percentage = Math.round(this.canvasZoom * 100);
        // toast.success(`縮放: ${percentage}%`); // 移除：縮放時不顯示 toast
    }

    /**
     * 在指定點縮放（用於滾輪縮放）
     */
    zoomAtPoint(delta, mouseX, mouseY) {
        const oldZoom = this.canvasZoom;
        this.canvasZoom = Math.max(0.25, Math.min(3.0, this.canvasZoom + delta));

        if (oldZoom === this.canvasZoom) return;

        // 計算縮放前的滾動位置
        const oldScrollX = this.container.scrollLeft;
        const oldScrollY = this.container.scrollTop;

        // 應用縮放
        this.applyCanvasZoom();

        // 調整滾動位置，使滑鼠位置保持不變
        const zoomRatio = this.canvasZoom / oldZoom;
        const newScrollX = (oldScrollX + mouseX) * zoomRatio - mouseX;
        const newScrollY = (oldScrollY + mouseY) * zoomRatio - mouseY;

        this.container.scrollLeft = newScrollX;
        this.container.scrollTop = newScrollY;

        const percentage = Math.round(this.canvasZoom * 100);
        // toast.success(`縮放: ${percentage}%`); // 移除：滾輪縮放時不顯示 toast
    }


    /**
     * 設定固定縮放級別（以滑鼠位置為中心）
     */
    setZoom(zoom, mouseX = null, mouseY = null) {
        const oldZoom = this.canvasZoom;
        this.canvasZoom = zoom;

        // 如果有滑鼠位置，以滑鼠為中心縮放
        if (mouseX !== null && mouseY !== null) {
            const containerRect = this.container.getBoundingClientRect();
            const relativeX = mouseX - containerRect.left;
            const relativeY = mouseY - containerRect.top;

            // 計算縮放前的滾動位置
            const oldScrollX = this.container.scrollLeft;
            const oldScrollY = this.container.scrollTop;

            // 應用縮放
            this.applyCanvasZoom();

            // 調整滾動位置，使滑鼠位置保持不變
            const zoomRatio = this.canvasZoom / oldZoom;
            const newScrollX = (oldScrollX + relativeX) * zoomRatio - relativeX;
            const newScrollY = (oldScrollY + relativeY) * zoomRatio - relativeY;

            this.container.scrollLeft = newScrollX;
            this.container.scrollTop = newScrollY;
        } else {
            // 沒有滑鼠位置，直接縮放
            this.applyCanvasZoom();
        }

        const percentage = Math.round(zoom * 100);
        toast.success(`縮放: ${percentage}%`);
    }

    /**
     * 重置縮放
     */
    resetZoom() {
        this.canvasZoom = 1.0;
        this.applyCanvasZoom();
        toast.success('縮放已重置 (100%)');
    }

    /**
     * 適應螢幕（顯示所有節點）
     */
    fitScreen() {
        if (this.nodes.length === 0) {
            toast.warning('沒有節點可顯示');
            return;
        }

        // 計算所有節點的邊界
        let minX = Infinity, minY = Infinity;
        let maxX = -Infinity, maxY = -Infinity;

        this.nodes.forEach(node => {
            const x = node.position.x;
            const y = node.position.y;
            const width = 250; // 節點平均寬度
            const height = 200; // 節點平均高度

            minX = Math.min(minX, x);
            minY = Math.min(minY, y);
            maxX = Math.max(maxX, x + width);
            maxY = Math.max(maxY, y + height);
        });

        // 計算需要的縮放比例
        const contentWidth = maxX - minX + 100; // 添加邊距
        const contentHeight = maxY - minY + 100;
        const containerWidth = this.container.clientWidth;
        const containerHeight = this.container.clientHeight;

        const scaleX = containerWidth / contentWidth;
        const scaleY = containerHeight / contentHeight;
        const targetZoom = Math.min(scaleX, scaleY, 1.0); // 最大不超過 100%

        this.canvasZoom = Math.max(0.25, targetZoom);
        this.applyCanvasZoom();

        // 置中顯示
        const centerX = (minX + maxX) / 2;
        const centerY = (minY + maxY) / 2;

        this.container.scrollLeft = centerX * this.canvasZoom - containerWidth / 2;
        this.container.scrollTop = centerY * this.canvasZoom - containerHeight / 2;

        const percentage = Math.round(this.canvasZoom * 100);
        toast.success(`已適應螢幕 (${percentage}%)`);
    }

    /**
     * 聚焦到指定節點（居中並放大）
     */
    focusOnNode(nodeId) {
        const node = this.nodes.find(n => n.id === nodeId);
        if (!node) return;

        const nodeElement = document.getElementById(nodeId);
        if (!nodeElement) return;

        // 獲取畫布和節點的尺寸
        const containerRect = this.container.getBoundingClientRect();
        const nodeWidth = nodeElement.offsetWidth;
        const nodeHeight = nodeElement.offsetHeight;

        // 計算需要的平移量，使節點居中
        const centerX = containerRect.width / 2;
        const centerY = containerRect.height / 2;

        // 節點當前位置
        const nodeCenterX = node.position.x + nodeWidth / 2;
        const nodeCenterY = node.position.y + nodeHeight / 2;

        // 計算需要移動的距離
        const deltaX = centerX - nodeCenterX;
        const deltaY = centerY - nodeCenterY;

        // 平移所有節點
        this.nodes.forEach(n => {
            n.position.x += deltaX;
            n.position.y += deltaY;
        });

        //設置縮放為 1.5x
        this.canvasZoom = 1.5;

        // 重新渲染
        this.renderAll();
        this.saveToLocalStorage();

        // 選中該節點
        this.selectNode(nodeId);
        this.showNodeProperties(nodeId);

        console.log(`🎯 已聚焦到節點: ${nodeId}, zoom: ${this.canvasZoom}`);
    }

    /**
     * 應用畫布縮放
     */
    applyCanvasZoom() {
        if (!this.canvasContent) return;

        this.canvasContent.style.transform = `scale(${this.canvasZoom})`;
        this.canvasContent.style.transformOrigin = 'top left';

        // 調整內容容器大小以配合縮放
        const baseSize = 5000;
        this.canvasContent.style.width = `${baseSize}px`;
        this.canvasContent.style.height = `${baseSize}px`;
    }

    /**
     * 刪除節點（包含級聯刪除展開的子節點）
     */
    deleteNode(nodeId) {
        if (!confirm('確定要刪除此節點嗎？')) return;

        // ✅ 收集所有要刪除的節點（包含子節點）
        const nodesToDelete = this.collectChildNodes(nodeId);
        nodesToDelete.push(nodeId);  // 加入自己

        console.log(`[刪除節點] 將刪除 ${nodesToDelete.length} 個節點:`, nodesToDelete);

        // ✅ 先刪除相關的邊的 DOM 元素（SVG path 和控制點）
        const edgesToRemove = this.edges.filter(edge =>
            nodesToDelete.includes(edge.source) || nodesToDelete.includes(edge.target)
        );

        console.log(`[刪除節點] 將刪除 ${edgesToRemove.length} 條連線`);

        edgesToRemove.forEach(edge => {
            // 移除 SVG path（使用 edge.id）
            const pathElement = document.getElementById(edge.id);
            if (pathElement) {
                console.log(`[刪除節點] 移除連線 path:`, edge.id);
                pathElement.remove();
            }

            // 移除控制點（使用 data-edge-id 屬性）
            const controlPoint = document.querySelector(`[data-edge-id="${edge.id}"]`);
            if (controlPoint) {
                console.log(`[刪除節點] 移除控制點:`, edge.id);
                controlPoint.remove();
            }
        });

        // 刪除所有節點和相關的邊
        this.nodes = this.nodes.filter(n => !nodesToDelete.includes(n.id));
        this.edges = this.edges.filter(e =>
            !nodesToDelete.includes(e.source) && !nodesToDelete.includes(e.target)
        );

        // 從 DOM 移除所有節點元素
        nodesToDelete.forEach(id => {
            const element = document.getElementById(id);
            if (element) element.remove();
        });

        this.selectedNode = null;
        document.getElementById('sidebar').classList.remove('show');
        this.saveToLocalStorage();

        const message = nodesToDelete.length > 1
            ? `已刪除 ${nodesToDelete.length} 個節點（包含展開的子節點）`
            : '節點已刪除';
        toast.success(message);
    }

    /**
     * 遞歸收集所有子節點（從指定節點展開出來的節點）
     */
    collectChildNodes(nodeId, collected = []) {
        // 找到所有從這個節點連出去的邊
        const outgoingEdges = this.edges.filter(e => e.source === nodeId);

        outgoingEdges.forEach(edge => {
            const targetId = edge.target;

            // 避免重複收集
            if (!collected.includes(targetId)) {
                collected.push(targetId);
                // 遞歸收集該子節點的子節點
                this.collectChildNodes(targetId, collected);
            }
        });

        return collected;
    }

