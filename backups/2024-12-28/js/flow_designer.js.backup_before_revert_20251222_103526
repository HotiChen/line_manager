                            }

                            // 第二步：解析目標 Richmenu 並創建/連接
                            const actualRichmenuId = await dataLoader.resolveRichmenuAlias(targetAliasOrId);

                            if (!actualRichmenuId) {
                                console.error(`[自動展開] 無法解析 Richmenu ID/Alias: ${targetAliasOrId}`);
