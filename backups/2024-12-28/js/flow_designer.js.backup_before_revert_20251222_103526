        // 添加關閉按鈕
        const closeBtn = document.createElement('button');
        closeBtn.textContent = '關閉';
        closeBtn.style.cssText = `
            position: sticky;
            top: 0;
            float: right;
            margin-bottom: 10px;
            padding: 8px 16px;
            background: #e74c3c;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        `;
        closeBtn.onclick = () => {
            document.body.removeChild(overlay);
        };
        modal.insertBefore(closeBtn, modal.firstChild);

        // 添加遮罩
        const overlay = document.createElement('div');
        overlay.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
        `;
        overlay.onclick = () => {
            document.body.removeChild(overlay);
        };
        overlay.appendChild(modal);
        document.body.appendChild(overlay);

        toast.success('調試信息已顯示（同時已輸出到 Console）');

        return {
            nodes: this.nodes.length,
            edges: this.edges.length,
            summary: `${this.nodes.length} 個節點, ${this.edges.length} 條連接`
        };
    }

    /**
     * 儲存流程
     */
    async saveFlow() {
        const flowData = {
            id: this.flowId,
            name: this.flowName,
            nodes: this.nodes,
            edges: this.edges,
            createdAt: this.flowId ? undefined : new Date().toISOString(),
            updatedAt: new Date().toISOString()
        };

        try {
            const res = await fetch(`${apiBase}/flow/save`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': getUserId()
                },
                body: JSON.stringify(flowData)
            });

            if (!res.ok) throw new Error('儲存失敗');

            const result = await res.json();
            this.flowId = result.flowId;

            this.saveToLocalStorage();
            toast.success('✅ 流程已儲存');
        } catch (err) {
            console.error('儲存失敗:', err);
            toast.error('❌ 儲存失敗: ' + err.message);
        }
    }

    /**
     * 載入流程
     */
    async loadFlow(flowId) {
        try {
            const res = await fetch(`${apiBase}/flow/get/${flowId}`, {
                headers: { 'X-User-Id': getUserId() }
            });

            if (!res.ok) throw new Error('載入失敗');

            const flowData = await res.json();
            this.flowId = flowData.id;
            this.flowName = flowData.name;
            this.nodes = flowData.nodes;
            this.edges = flowData.edges;

            this.renderAll();
            toast.success('✅ 流程已載入');
        } catch (err) {
            console.error('載入失敗:', err);
            toast.error('❌ 載入失敗: ' + err.message);
        }
    }

    /**
     * 重新載入流程（刷新最新資料）
     */
    async reloadFlow() {
        try {
            showLoader('正在重新載入流程資料...');

            // 如果有 flowId，從後端載入
            if (this.flowId) {
                const res = await fetch(`${apiBase}/flow/get/${this.flowId}`, {
                    headers: { 'X-User-Id': getUserId() }
                });

                if (!res.ok) throw new Error('重新載入失敗');

                const flowData = await res.json();
                this.flowName = flowData.name;
                this.nodes = flowData.nodes;
                this.edges = flowData.edges;

                this.renderAll();

                // ✅ 重新載入所有 Richmenu 節點的圖片資料
                await this.refreshAllRichmenuData();

                toast.success('✅ 流程已從後端重新載入');
                console.log('🔄 流程已更新:', this.flowName);
            }
            // 如果沒有 flowId，從 localStorage 重新載入
            else {
                const data = localStorage.getItem('flow_designer_draft');
                if (data) {
                    const parsed = JSON.parse(data);
                    this.nodes = parsed.nodes || [];
                    this.edges = parsed.edges || [];
                    this.flowId = parsed.flowId;
                    this.flowName = parsed.flowName || '未命名流程';
                    this.renderAll();

                    // ✅ 重新載入所有 Richmenu 節點的圖片資料
                    await this.refreshAllRichmenuData();

                    toast.success('✅ 流程已從本地重新載入');
                    console.log('🔄 從 localStorage 重新載入');
                } else {
                    toast.warning('⚠️ 沒有可載入的流程資料');
                }
            }
        } catch (err) {
            console.error('重新載入失敗:', err);
            toast.error('❌ 重新載入失敗: ' + err.message);
        } finally {
            hideLoader();
        }
    }

    /**
     * 重新載入所有 Richmenu 節點的資料（圖片等）
     */
    async refreshAllRichmenuData() {
        const richmenuNodes = this.nodes.filter(n => n.type === NodeTypes.RICHMENU && n.data.richmenuId);

        if (richmenuNodes.length === 0) {
            console.log('[刷新 Richmenu] 沒有 Richmenu 節點需要刷新');
            return;
        }

        console.log(`[刷新 Richmenu] 開始刷新 ${richmenuNodes.length} 個 Richmenu 節點`);

        for (const node of richmenuNodes) {
            try {
                const details = await dataLoader.loadRichmenuDetails(node.data.richmenuId);
                if (details) {
                    // 更新節點資料
                    node.data.name = details.name;
                    node.data.imageUrl = details.imageUrl;
                    node.data.buttons = details.buttons || [];

                    // 重新渲染節點
                    const nodeElement = document.getElementById(node.id);
                    if (nodeElement) {
                        nodeElement.remove();
                        this.renderNode(node);
                    }

                    console.log(`[刷新 Richmenu] ✅ ${node.data.name} 已刷新`);
                }
            } catch (error) {
                console.error(`[刷新 Richmenu] ❌ ${node.id} 刷新失敗:`, error);
            }
        }

        console.log('[刷新 Richmenu] 全部完成');
    }

    /**
     * 重新渲染所有節點
     */
    renderAll() {
        // 清空畫布內容
        if (this.canvasContent) {
            this.canvasContent.remove();
        }

        // 重新創建 SVG 圖層和內容容器
        this.createSvgLayer();

        // 渲染所有節點
        this.nodes.forEach(node => this.renderNode(node));

        // 渲染所有連線
        this.edges.forEach(edge => this.renderEdge(edge));
    }

    /**
     * 儲存到 LocalStorage
     */
    saveToLocalStorage() {
        const data = {
            nodes: this.nodes,
            edges: this.edges,
            flowId: this.flowId,
            flowName: this.flowName
        };
        localStorage.setItem('flow_designer_draft', JSON.stringify(data));
    }

    /**
     * 從 LocalStorage 載入
     */
    loadFromLocalStorage() {
        const data = localStorage.getItem('flow_designer_draft');
        if (data) {
            try {
                const parsed = JSON.parse(data);
                this.nodes = parsed.nodes || [];
                this.edges = parsed.edges || [];
                this.flowId = parsed.flowId;
                this.flowName = parsed.flowName;
                this.renderAll();
                console.log('📂 已載入草稿');
            } catch (err) {
                console.error('載入草稿失敗:', err);
            }
        }
    }

    /**
     * 清空流程
     */
    clearFlow() {
        if (!confirm('確定要清空畫布嗎？未儲存的變更將遺失。')) return;

        this.nodes = [];
        this.edges = [];
        this.flowId = null;
        this.flowName = '未命名流程';
        this.renderAll();
        localStorage.removeItem('flow_designer_draft');

        toast.success('畫布已清空');
    }

    /**
     * 顯示 Flex Message 完整預覽
     */
    showFlexPreview(nodeId) {
        const node = this.nodes.find(n => n.id === nodeId);
        if (!node || !node.data.contents) {
            toast.error('無法載入 Flex Message 資料');
            return;
        }

        // 取得 modal 元素
        const modal = document.getElementById('flexPreviewModal');
        const content = document.getElementById('flexPreviewContent');

        // 清空內容
        content.innerHTML = '';

        try {
            // 檢查 flex2html 是否已載入
            if (typeof flex2html !== 'function') {
                toast.error('flex2html 尚未載入');
                console.error('flex2html function not found');
                return;
            }

            // 準備 Flex Message 資料
            const flexMessage = {
                type: 'flex',
                altText: node.data.altText || node.data.title || 'Flex Message',
                contents: node.data.contents
            };

            // 建立一個唯一的容器 ID
            const containerId = `flex-preview-${Date.now()}`;
            content.innerHTML = `<div id="${containerId}"></div>`;

            // 使用 flex2html 渲染
            flex2html(containerId, flexMessage);

            // 顯示 modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            toast.success('Flex Message 已渲染');

        } catch (error) {
            console.error('Flex Message 渲染錯誤:', error);
            toast.error('Flex Message 渲染失敗: ' + error.message);
            content.innerHTML = `
                <div class="alert alert-danger">
                    <strong>渲染錯誤</strong><br>
                    ${error.message}
                </div>
            `;
        }
    }
}

// 匯出供全域使用
export default FlowDesigner;

// =================================================================
// 🎯 pageInit - 頁面初始化函數（支援主頁面導航）
// =================================================================

/**
 * Flow Designer 頁面初始化函數
 * 
 * 用途：
 * 1. 讓 Flow Designer 可以從主頁面（index.html）導航進入
 * 2. 防止重複初始化
 * 3. 與其他 builder (richmenu, flex, imagemap) 保持一致
 * 
 * 呼叫時機：
 * - 從主頁面點擊「視覺化流程設計」
 * - 直接訪問 flow_designer_full.html
 * - 從其他頁面跳轉回來
 */
export function pageInit() {
    console.log('🎨 [Flow Designer] pageInit 執行');

    // 防止重複初始化
    if (window._flowDesignerInitialized) {
        console.log('[Flow Designer] 已初始化，跳過重複初始化');
        return;
    }

    try {
        // 檢查容器是否存在
        const container = document.getElementById('flow-canvas');
        if (!container) {
            console.error('[Flow Designer] 找不到容器 #flow-canvas');
            return;
        }

        // 初始化 Flow Designer
        console.log('[Flow Designer] 創建 FlowDesigner 實例...');
        window.flowDesigner = new FlowDesigner('flow-canvas');

        // 標記已初始化
        window._flowDesignerInitialized = true;

        console.log('✅ [Flow Designer] 初始化完成');
        console.log('💡 提示: 右鍵點擊畫布可新增節點');

    } catch (error) {
        console.error('❌ [Flow Designer] 初始化失敗:', error);
        window._flowDesignerInitialized = false;
    }
}

// 自動執行初始化（如果直接訪問此頁面）
if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', pageInit);
    } else {
        // DOM 已載入，立即執行
        pageInit();
    }
}
