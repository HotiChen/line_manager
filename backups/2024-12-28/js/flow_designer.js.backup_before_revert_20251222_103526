    /**
     * 使節點可拖曳
     */
    makeDraggable(element, node) {
        let isDragging = false;
        let startX, startY;

        element.addEventListener('mousedown', (e) => {
            if (e.target.classList.contains('bi')) return; // 忽略圖示點擊
            if (e.target.tagName === 'BUTTON') return; // 忽略按鈕點擊
            isDragging = true;
            // ✅ 考慮縮放：clientX 需要除以 zoom 才是實際畫布座標
            startX = (e.clientX / this.canvasZoom) - node.position.x;
            startY = (e.clientY / this.canvasZoom) - node.position.y;
            element.style.zIndex = 1000;
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            // ✅ 考慮縮放：clientX 除以 zoom 才是實際畫布座標
            node.position.x = (e.clientX / this.canvasZoom) - startX;
            node.position.y = (e.clientY / this.canvasZoom) - startY;
            element.style.left = node.position.x + 'px';
            element.style.top = node.position.y + 'px';

            // ✅ 實時更新相關連線（使用 requestAnimationFrame 優化）
            if (!this._dragUpdateScheduled) {
                this._dragUpdateScheduled = true;
                requestAnimationFrame(() => {
                    this.updateConnectedEdges(node.id);
                    this._dragUpdateScheduled = false;
                });
            }
        });

        document.addEventListener('mouseup', () => {
            if (isDragging) {
                isDragging = false;
                element.style.zIndex = 1;
                this.saveToLocalStorage();
            }
        });
    }

    /**
     * 更新與節點相關的所有連線
     */
    updateConnectedEdges(nodeId) {
        // console.log(`[updateConnectedEdges] 更新節點 ${nodeId} 的連接`);

        // 找到所有與此節點相關的連線
        const relatedEdges = this.edges.filter(edge =>
            edge.source === nodeId || edge.target === nodeId
        );

        // console.log(`[updateConnectedEdges] 找到 ${relatedEdges.length} 條相關連接`);

        // 重新繪製每條連線
        relatedEdges.forEach(edge => {
            const pathElement = document.getElementById(edge.id);

            if (pathElement) {
                // 更新路徑（使用 calculateEdgePath 會自動使用正確的貝茲曲線）
                const newPath = this.calculateEdgePath(edge);
                if (newPath) {
                    pathElement.setAttribute('d', newPath);
                    // console.log(`[updateConnectedEdges] ✅ 已更新連接 ${edge.id}`);
                } else {
                    console.warn(`[updateConnectedEdges] 無法計算路徑:`, edge);
                }
            } else {
                console.warn(`[updateConnectedEdges] 找不到路徑元素:`, edge.id);
            }
        });
    }

    /**
     * 計算連線的路徑（用於拖動更新）
     */
    calculateEdgePath(edge) {
        const sourceNode = this.nodes.find(n => n.id === edge.source);
        const targetNode = this.nodes.find(n => n.id === edge.target);

        if (!sourceNode || !targetNode) {
            console.warn(`[calculateEdgePath] 找不到節點: ${edge.source} -> ${edge.target} `);
            return null;
        }

        const sourceElement = document.getElementById(edge.source);
        const targetElement = document.getElementById(edge.target);

        if (!sourceElement || !targetElement) {
            console.warn(`[calculateEdgePath] 找不到節點元素`);
            return null;
        }

        // 獲取節點尺寸
        const sourceWidth = sourceElement.offsetWidth;
        const sourceHeight = sourceElement.offsetHeight;
        const targetWidth = targetElement.offsetWidth;
        const targetHeight = targetElement.offsetHeight;

        // 直接使用節點的 position 屬性
        const startX = sourceNode.position.x + sourceWidth;
        const startY = sourceNode.position.y + sourceHeight / 2;
        const endX = targetNode.position.x;
        const endY = targetNode.position.y + targetHeight / 2;

        // 使用保存的控制點（如果有）
        return this.createCurvePath(startX, startY, endX, endY, edge.controlPoint);
    }

