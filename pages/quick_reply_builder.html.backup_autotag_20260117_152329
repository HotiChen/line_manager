<!-- Quick Reply 編輯器頁面 -->
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1"><i class="bi bi-lightning-charge text-warning"></i> Quick Reply 快速回覆管理</h4>
                    <p class="text-muted mb-0">建立和管理快速回覆按鈕，附加到訊息下方提升互動率</p>
                </div>
                <button type="button" class="btn btn-primary" id="create-quick-reply-btn">
                    <i class="bi bi-plus-lg"></i> 新增 Quick Reply
                </button>
            </div>

            <!-- Quick Reply 列表 -->
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-collection"></i> 已儲存的 Quick Reply</span>
                        <input type="text" class="form-control form-control-sm" id="search-quick-reply"
                            placeholder="搜尋..." style="width: 200px;">
                    </div>
                </div>
                <div class="card-body">
                    <div id="quick-reply-list">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-lightning-charge" style="font-size: 3rem;"></i>
                            <p class="mt-2">尚無快速回覆，點擊上方按鈕新增</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 新增/編輯 Modal -->
<div class="modal fade" id="quick-reply-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-lightning-charge text-warning"></i> 編輯 Quick Reply</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">名稱 <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="quick-reply-name" placeholder="例如：常見問題回覆">
                </div>
                <div id="quick-reply-editor-container">
                    <!-- Quick Reply 編輯器會插入這裡 -->
                </div>
                <div class="mt-3">
                    <label class="form-label">預覽</label>
                    <div id="quick-reply-preview" class="border rounded p-3 bg-light">
                        <div class="text-muted text-center">新增按鈕後這裡會顯示預覽</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="save-quick-reply-btn">
                    <i class="bi bi-check-lg"></i> 儲存
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CSS 樣式 -->
<style>
    .quick-reply-item {
        transition: all 0.2s ease;
    }

    .quick-reply-item:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .quick-reply-item .action-fields {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .quick-reply-preview-btn {
        display: inline-block;
        padding: 8px 16px;
        margin: 4px;
        background: linear-gradient(135deg, #00B900, #00C300);
        color: white;
        border-radius: 20px;
        font-size: 14px;
        cursor: pointer;
        transition: transform 0.1s;
    }

    .quick-reply-preview-btn:hover {
        transform: scale(1.05);
    }

    .quick-reply-list-item {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.2s;
    }

    .quick-reply-list-item:hover {
        background: #f8f9fa;
        border-color: #0d6efd;
    }

    /* 列表中的 QuickReply 預覽樣式 */
    .quick-reply-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .qr-preview-btn {
        display: inline-block;
        padding: 4px 12px;
        background: linear-gradient(135deg, #00B900, #00C300);
        color: white;
        border-radius: 16px;
        font-size: 12px;
        white-space: nowrap;
        box-shadow: 0 1px 3px rgba(0, 185, 0, 0.3);
        transition: all 0.2s;
    }

    .qr-preview-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(0, 185, 0, 0.4);
    }
</style>